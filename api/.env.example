# anydag-api's configuration: `cp api/.env.example api/.env`, fill in, and have the process read
# it (`set -a; . api/.env; set +a`, or compose's `env_file`). Every value empty here is the
# default in the comment; nothing here runs without a database unless PGlite is fine.
#
# Security: secrets come only from the environment. The admin token and the feedback token never
# appear in the boot line or an error (#99): both print `<redacted>`. Give this file 0600
# permissions, and never commit it — `.gitignore` holds `.env`, and gitleaks scans the tree.

# -- the service ------------------------------------------------------------------------------

# The port it answers on, and the address it binds.
# Default: 8790, and 127.0.0.1 — a self-hosted server is reachable from this machine alone; in a
# container set 0.0.0.0.
#ANYDAG_API_PORT=8790
#ANYDAG_API_HOST=127.0.0.1

# The server's own folder: PGlite (`pg/`), the blobs (`blobs/`) and the logs (`logs/`). Relative
# to the working directory; the image keeps it at /data.
#ANYDAG_API_DATA=anydag-api-data

# Where a person reaches this server — printed beside a pairing code, and the vault address a
# self-hoster pastes. Set it when TLS or a proxy stands in front.
#ANYDAG_API_PUBLIC_URL=http://127.0.0.1:8790

# The database: a Postgres URL. Unset means PGlite in <data>/pg — one process's, fine for one
# self-hoster, never for two processes; the deployment in deploy/ runs Postgres here.
#DATABASE_URL=

# single: one owner, first boot mints the account and prints a pairing code. multi: the admin
# routes and the CLI make accounts.
#ANYDAG_API_MODE=single

# -- features ---------------------------------------------------------------------------------

# One switch per feature; an off feature's routes answer 404, and GET /v1 says so.
#ANYDAG_API_SYNC=on
#ANYDAG_API_LOGS=on
#ANYDAG_API_FEEDBACK=on

# The feedback relay (#50) files into a GitHub repository through issues. No token, or no repo:
# every relay answers 503, and GET /v1 reports the feature as absent. The token is a fine-grained
# GitHub token that can open issues and upload attachments in that one repo — nothing more.
#ANYDAG_API_FEEDBACK_GITHUB_TOKEN=
#ANYDAG_API_FEEDBACK_REPO=owner/repo

# -- limits -----------------------------------------------------------------------------------

# How long a superseded blob and a compacted log row are kept, unless a plan says otherwise, and
# how many days of logs sit in <data>/logs/.
#ANYDAG_API_HISTORY_DAYS=30
#ANYDAG_API_LOGS_DAYS=30

# The largest blob upload this server reads at all (MB), whatever a plan allows.
#ANYDAG_API_MAX_BODY_MB=512

# -- operations -------------------------------------------------------------------------------

# The admin routes (`/v1/admin/*`, `/metrics`) are answerable only with this token; unset, they
# refuse everybody with 403. At least 16 characters, and 32 in production: NODE_ENV=production
# refuses a shorter one at boot. Generate it, never invent it: `openssl rand -base64 32`.
#ANYDAG_API_ADMIN_TOKEN=

# How clients learn a commit landed at once: on, they hold a poke stream open; off, they poll.
#ANYDAG_API_POKE=on

# The client address a rate limiter reads: off, the socket's own — safe from a forged
# X-Forwarded-For; or the number of proxy hops in front (1 behind one Caddy, as deploy/ runs it),
# in which case the last address the innermost proxy added is who asked.
#ANYDAG_API_TRUST_PROXY=off
