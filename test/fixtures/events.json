{
  "//": "What makes a note an event, read and written by `eventOf`/`withEvent`/`whenOf` in src/note/event.ts (test/events.test.ts), which the server, the page and the CLI all import. One list of cases, so the sidebar, the calendar and a card on a board cannot disagree about what a note is. The parsers check the form of a value and never the order of two.",
  "read": [
    { "why": "an all-day event", "text": "---\ntitle: Conference\nstart: 2026-10-12\n---\nbody\n", "event": { "start": "2026-10-12" } },
    { "why": "an all-day event over three days", "text": "---\ntitle: Conference\nstart: 2026-10-12\nend: 2026-10-14\n---\n", "event": { "start": "2026-10-12", "end": "2026-10-14" } },
    { "why": "a timed event with its offset", "text": "---\nstart: 2026-10-03T09:00+02:00\nend: 2026-10-03T17:00+02:00\n---\n", "event": { "start": "2026-10-03T09:00+02:00", "end": "2026-10-03T17:00+02:00" } },
    { "why": "UTC", "text": "---\nstart: 2026-10-03T07:00Z\n---\n", "event": { "start": "2026-10-03T07:00Z" } },
    { "why": "a lower-case z", "text": "---\nstart: 2026-10-03T07:00z\n---\n", "event": { "start": "2026-10-03T07:00Z" } },
    { "why": "an offset with no colon", "text": "---\nstart: 2026-10-03T09:00+0200\n---\n", "event": { "start": "2026-10-03T09:00+02:00" } },
    { "why": "an offset in hours alone", "text": "---\nstart: 2026-10-03T09:00-05\n---\n", "event": { "start": "2026-10-03T09:00-05:00" } },
    { "why": "a half-hour offset", "text": "---\nstart: 2026-10-03T09:00+05:30\n---\n", "event": { "start": "2026-10-03T09:00+05:30" } },
    { "why": "a space where the T goes", "text": "---\nstart: 2026-10-03 09:00+02:00\n---\n", "event": { "start": "2026-10-03T09:00+02:00" } },
    { "why": "a lower-case t", "text": "---\nstart: 2026-10-03t09:00+02:00\n---\n", "event": { "start": "2026-10-03T09:00+02:00" } },
    { "why": "seconds are kept", "text": "---\nstart: 2026-10-03T09:00:30+02:00\n---\n", "event": { "start": "2026-10-03T09:00:30+02:00" } },
    { "why": "a time written by hand without an offset is read as it is", "text": "---\nstart: 2026-10-03T09:00\nend: 2026-10-03T10:30\n---\n", "event": { "start": "2026-10-03T09:00", "end": "2026-10-03T10:30" } },
    { "why": "quoted, and trimmed", "text": "---\nstart: \" 2026-10-03T09:00+02:00 \"\n---\n", "event": { "start": "2026-10-03T09:00+02:00" } },
    { "why": "an end before its start is read as written", "text": "---\nstart: 2026-10-14\nend: 2026-10-12\n---\n", "event": { "start": "2026-10-14", "end": "2026-10-12" } },
    { "why": "a time for the end of an all-day event is no end", "text": "---\nstart: 2026-10-12\nend: 2026-10-12T17:00+02:00\n---\n", "event": { "start": "2026-10-12" } },
    { "why": "a date for the end of a timed event is no end", "text": "---\nstart: 2026-10-12T09:00+02:00\nend: 2026-10-13\n---\n", "event": { "start": "2026-10-12T09:00+02:00" } },
    { "why": "an end that is not a date or a time is no end", "text": "---\nstart: 2026-10-12\nend: tomorrow\n---\n", "event": { "start": "2026-10-12" } },
    { "why": "a status makes it a task, and never also an event", "text": "---\nstatus: todo\nstart: 2026-10-12\n---\n", "event": null },
    { "why": "a status that is not one is no task, so the start makes an event", "text": "---\nstatus: blocked\nstart: 2026-10-12\n---\n", "event": { "start": "2026-10-12" } },
    { "why": "a project with a start is an event too", "text": "---\nproject: active\nstart: 2026-10-12\n---\n", "event": { "start": "2026-10-12" } },
    { "why": "an end alone is not an event", "text": "---\nend: 2026-10-12\n---\n", "event": null },
    { "why": "a due date is not an event's end", "text": "---\nstart: 2026-10-12\ndue: 2026-10-14\n---\n", "event": { "start": "2026-10-12" } },
    { "why": "a day that does not exist", "text": "---\nstart: 2026-02-30\n---\n", "event": null },
    { "why": "an hour that does not exist", "text": "---\nstart: 2026-10-03T24:00+02:00\n---\n", "event": null },
    { "why": "a minute that does not exist", "text": "---\nstart: 2026-10-03T09:60+02:00\n---\n", "event": null },
    { "why": "an offset further than any clock is kept", "text": "---\nstart: 2026-10-03T09:00+15:00\n---\n", "event": null },
    { "why": "the furthest offset there is", "text": "---\nstart: 2026-10-03T09:00+14:00\n---\n", "event": { "start": "2026-10-03T09:00+14:00" } },
    { "why": "a time with no minutes", "text": "---\nstart: 2026-10-03T09+02:00\n---\n", "event": null },
    { "why": "a start that is a number", "text": "---\nstart: 20261003\n---\n", "event": null },
    { "why": "an empty start", "text": "---\nstart:\n---\n", "event": null },
    { "why": "a start under another key is not the note's", "text": "---\nevent:\n  start: 2026-10-12\n---\n", "event": null },
    { "why": "no frontmatter", "text": "start: 2026-10-12\n", "event": null },
    { "why": "a frontmatter that is not YAML", "text": "---\nstart: [\n---\n", "event": null },
    { "why": "CRLF line ends", "text": "---\r\nstart: 2026-10-12\r\nend: 2026-10-13\r\n---\r\nbody", "event": { "start": "2026-10-12", "end": "2026-10-13" } }
  ],
  "write": [
    { "why": "a start and an end added after the title", "text": "---\ntitle: Offsite\n---\nbody\n", "set": { "start": "2026-10-03T09:00+02:00", "end": "2026-10-03T17:00+02:00" }, "out": "---\ntitle: Offsite\nstart: 2026-10-03T09:00+02:00\nend: 2026-10-03T17:00+02:00\n---\nbody\n" },
    { "why": "a start changed where it is", "text": "---\nstart: 2026-10-12\ntitle: T\n---\n", "set": { "start": "2026-10-13" }, "out": "---\nstart: 2026-10-13\ntitle: T\n---\n" },
    { "why": "an end taken out", "text": "---\ntitle: T\nstart: 2026-10-12\nend: 2026-10-14\n---\nbody", "set": { "end": null }, "out": "---\ntitle: T\nstart: 2026-10-12\n---\nbody" },
    { "why": "no longer an event, and the title stays", "text": "---\ntitle: T\nstart: 2026-10-12\nend: 2026-10-14\n---\nbody", "set": { "start": null, "end": null }, "out": "---\ntitle: T\n---\nbody" },
    { "why": "a block left empty goes altogether", "text": "---\nstart: 2026-10-12\n---\nbody", "set": { "start": null }, "out": "body" },
    { "why": "a note with no frontmatter grows one, with nothing after it", "text": "body\n", "set": { "start": "2026-10-12" }, "out": "---\nstart: 2026-10-12\n---\nbody\n" },
    { "why": "the task's keys are left alone", "text": "---\nstatus: todo\ndue: 2026-10-14\n---\n", "set": { "end": null }, "out": "---\nstatus: todo\ndue: 2026-10-14\n---\n" }
  ],
  "when": [
    { "why": "a date", "raw": "2026-10-12", "when": "2026-10-12" },
    { "why": "a time with its offset", "raw": "2026-10-12T09:00+02:00", "when": "2026-10-12T09:00+02:00" },
    { "why": "a negative offset with no colon", "raw": "2026-10-12T09:00-0330", "when": "2026-10-12T09:00-03:30" },
    { "why": "minus zero", "raw": "2026-10-12T09:00-00:00", "when": "2026-10-12T09:00-00:00" },
    { "why": "a time without one", "raw": "2026-10-12T09:00", "when": "2026-10-12T09:00" },
    { "why": "blanks around it", "raw": "  2026-10-12  ", "when": "2026-10-12" },
    { "why": "a time alone is not a moment", "raw": "09:00", "when": null },
    { "why": "two spaces where the T goes", "raw": "2026-10-12  09:00", "when": null },
    { "why": "a space before the offset", "raw": "2026-10-12T09:00 +02:00", "when": null },
    { "why": "an offset of a minute past fourteen hours", "raw": "2026-10-12T09:00+14:01", "when": null },
    { "why": "an offset with sixty minutes", "raw": "2026-10-12T09:00+02:60", "when": null },
    { "why": "a second that does not exist", "raw": "2026-10-12T09:00:60Z", "when": null },
    { "why": "not a string", "raw": 20261012, "when": null }
  ]
}
