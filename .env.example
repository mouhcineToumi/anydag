# The prompt card's models (`plugins/generate/providers.ts`).
#
# Copy to `.env.local` (git-ignored, like every `*.local`) and fill in what you use. The dev server
# reads these per request, so a key added here counts without a restart. None of it ever reaches
# the browser: the page names a provider by id, and `GET /__board/llm` says only whether a key is set.

# Gemini — the default provider, through Google's OpenAI-compatible endpoint.
# GEMINI_API_KEY=

# GLM from Z.ai, over its own OpenAI-compatible API.
# ZHIPU_API_KEY=

# Claude needs no key either: the `claude` provider runs `claude -p` on whatever Claude Code on this
# machine is signed into, which is the person's own Claude subscription. Found on PATH, then where its
# installers put it (~/.local/bin, ~/.claude/local, …); this names it outright.
# ANYDAG_CLAUDE_BIN=/home/me/.local/bin/claude

# OpenCode needs no key here either: the `opencode` provider runs `opencode run` (2.x) on whatever
# OpenCode on this machine is signed into, OpenCode Go among them. Found on PATH, then where its
# installers put it (~/.opencode/bin, mise's shims, …); this names it outright. (Go's HTTP endpoint is
# for coding agents, not for this.)
# ANYDAG_OPENCODE_BIN=/home/me/.opencode/bin/opencode

# Anything else that speaks OpenAI's chat completions — OpenRouter, Ollama, a local vLLM.
# ANYDAG_LLM_BASE_URL=http://localhost:11434/v1
# ANYDAG_LLM_API_KEY=
# ANYDAG_LLM_MODEL=qwen3:32b

# Which provider a card uses when the settings card names none, and its model.
# ANYDAG_LLM_PROVIDER=gemini
# ANYDAG_LLM_MODEL=gemini-3.8-flash

# Knobs. Attempts is how many times the fix loop may ask (first try included); timeout is per run.
# ANYDAG_LLM_ATTEMPTS=3
# ANYDAG_LLM_TIMEOUT=120000
# ANYDAG_LLM_TEMPERATURE=
# ANYDAG_LLM_REASONING=low        # `reasoning_effort` for the HTTP providers; Gemini sends `low` unless
#                             # told otherwise, and `default` sends none (the model's own, ~3× slower).
#                             # The Thinking select in the settings card outranks this per window.
# ANYDAG_LLM_VARIANT=             # OpenCode's variant, sent as `model#variant`: `low`, `high`, `max`, as the model has them

# anydag-sync: the server's port, and its Postgres's port on this machine.
ANYDAG_SYNC_PORT=8790
ANYDAG_SYNC_PG_PORT=55432

