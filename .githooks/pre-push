#!/usr/bin/env bash
#
# Before a push: the two cheap checks that only CI used to run, and — when asked — the browser suite
# the push can have changed.
#
# **What it runs, and why that and nothing else** (#258, which has the numbers). The checks that
# went red on a pull request were the ones no hook ran: `npm run lint:promises` (typescript-eslint's
# promise rules over `e2e/` and `desktop/` too, ~27 s) and the store's contracts over a watched vault
# (`ANYDAG_TEST_WATCH=1 vitest run test/server`, ~18 s). They run here side by side, about half a
# minute, so a push that would fail them does not leave the machine. The browser suite does **not**
# run by default any more: it was the same `@smoke` grep, in the same image, that the pull request's
# `e2e` run starts a minute later (`.github/workflows/e2e.yml`, which now also runs the specs the
# change reaches) — a minute of every push spent repeating CI.
#
#   1. **Nothing new** — every pushed commit is already on a remote (`git rev-list <sha> --not
#      --remotes` is empty: a new branch pointing at an existing commit, a tag) → skipped, with a line.
#   2. **A deleted branch** — git writes an all-zero sha for it → nothing to check.
#   3. **Only prose** — every changed path is a `.md` outside `boards/`, or under `docs/` → nothing to
#      check; neither check reads one.
#   4. **Otherwise** the two checks, and with `ANYDAG_PREPUSH_E2E=1` also the browser selection
#      `scripts/e2e-plan.mjs` answers — prose and CI config nothing; application code the `@smoke`
#      tier; what can move pixels also the 45 reference screenshots; `api/` also `sync.spec.ts`; a
#      change under `e2e/` the specs Playwright's `--only-changed` traces it to — in Playwright's
#      Docker image (`scripts/e2e-docker.sh`), or on the host with no screenshots when Docker is not
#      running (`scripts/e2e-local.sh`), which says so. `ANYDAG_E2E_HOST=1` asks for the host.
#
# `ANYDAG_NO_HOOK=1` is the escape hatch beside `--no-verify`, and a checkout with no `node_modules`
# is skipped with a word rather than refused — the same argument `.githooks/pre-commit` and
# `check-skill.mjs` make. Everything runs on the working tree, as it always has: push the branch you
# are standing on.
set -euo pipefail

if [ -n "${ANYDAG_NO_HOOK:-}" ]; then
  echo "pre-push: skipped (ANYDAG_NO_HOOK)"
  exit 0
fi

if [ ! -d node_modules ]; then
  echo "pre-push: skipping the checks — no node_modules; run: npm ci"
  exit 0
fi

zero="0000000000000000000000000000000000000000"
heads=()
pushing=

while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  pushing=yes
  # A commit is new if no remote-tracking branch has it.
  if [ -n "$(git rev-list --max-count=1 "$local_sha" --not --remotes 2>/dev/null)" ]; then
    heads+=("$local_sha")
  fi
done

if [ -z "$pushing" ]; then
  echo "pre-push: nothing being pushed"
  exit 0
fi

if [ "${#heads[@]}" -eq 0 ]; then
  echo "pre-push: nothing new — every pushed commit is already on a remote; no checks"
  exit 0
fi

# What the push changes, against what it will be merged into. No base to compare with → treat it as
# code, the safe side.
base=
for b in origin/develop origin/main; do
  if git rev-parse --verify --quiet "$b^{commit}" >/dev/null; then base="$b"; break; fi
done
code=yes
if [ -n "$base" ]; then
  code=
  while read -r f; do
    [ -z "$f" ] && continue
    case "$f" in
      boards/*) code=yes; break ;;
      docs/* | *.md) ;;
      *) code=yes; break ;;
    esac
  done < <(for h in "${heads[@]}"; do git diff --name-only "$base...$h"; done | sort -u)
fi

if [ -z "$code" ]; then
  echo "pre-push: only prose changed; no checks"
  exit 0
fi

# The two checks side by side, each into its own log, and the log of one that failed printed whole.
echo "pre-push: lint:promises and the store's contracts over a watched vault"
logs="$(mktemp -d)"
trap 'rm -rf "$logs"' EXIT
npm run --silent lint:promises >"$logs/promises" 2>&1 &
promises=$!
ANYDAG_TEST_WATCH=1 ANYDAG_CLOUD=on npx vitest run test/server >"$logs/watched" 2>&1 &
watched=$!
failed=
wait "$promises" || { echo; echo "pre-push: npm run lint:promises failed:"; cat "$logs/promises"; failed=yes; }
wait "$watched" || { echo; echo "pre-push: ANYDAG_TEST_WATCH=1 vitest run test/server failed:"; cat "$logs/watched"; failed=yes; }
[ -n "$failed" ] && exit 1
echo "pre-push: both passed"
rm -rf "$logs"
trap - EXIT

if [ -z "${ANYDAG_PREPUSH_E2E:-}" ]; then
  echo "pre-push: the browser suite runs on the pull request (ANYDAG_PREPUSH_E2E=1 runs its selection here first)"
  exit 0
fi

plan_args=()
for h in "${heads[@]}"; do plan_args+=(--head "$h"); done
plan="$(node scripts/e2e-plan.mjs "${plan_args[@]}")"
field() { printf '%s' "$plan" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const v=JSON.parse(s)[process.argv[1]];process.stdout.write(v==null?"":String(v))})' "$1"; }

if [ "$(field run)" != "true" ]; then
  echo "pre-push: $(field why); no browser tests"
  exit 0
fi

# One line a test, not fifty: a push is not the place to read a list reporter.
selection=(--reporter=line)
grep="$(field grep)"
[ -n "$grep" ] && selection+=(--grep "$grep")
echo "pre-push: $(field why)"

use_docker=yes
if [ -n "${ANYDAG_E2E_HOST:-}" ]; then
  use_docker=
elif ! docker info >/dev/null 2>&1; then
  echo "pre-push: docker is not running — the host's browser runs this selection, comparing no screenshots (start docker for the real thing)"
  use_docker=
fi

if [ -n "$use_docker" ]; then
  exec bash scripts/e2e-docker.sh "${selection[@]}"
fi
exec bash scripts/e2e-local.sh "${selection[@]}"
