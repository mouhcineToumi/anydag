{
  "name": "anydag",
  "author": "AnyDag contributors",
  "license": "MIT",
  "description": "A local infinite canvas Claude draws on: notes, boards, quizzes, tables and tasks in a folder of your disk.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.7"
  },
  "version": "0.4.0",
  "main": "desktop/dist/main.cjs",
  "desktopName": "anydag.desktop",
  "bin": {
    "anydag": "cli/anydag.mjs"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:vite": "vite",
    "start": "vite",
    "build": "vite build",
    "stamp": "node scripts/stamp.mjs",
    "anydag": "node cli/anydag.mjs",
    "server:build": "node server/build.mjs",
    "serve": "node server/build.mjs && node server/dist/anydag-server.mjs",
    "parity": "node scripts/parity.mjs",
    "cli:build": "node cli/build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p desktop",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check:version": "node scripts/check-version.mjs",
    "check:case": "node scripts/check-case.mjs",
    "check:theme": "node scripts/check-theme.mjs",
    "check:literals": "node scripts/check-literals.mjs",
    "icons:build": "node scripts/icons/vendor.mjs && node scripts/icons/build.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "check:skill": "node scripts/check-skill.mjs",
    "lint": "biome lint .",
    "lint:promises": "eslint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "knip": "knip",
    "checks": "bash scripts/checks.sh",
    "e2e:local": "bash scripts/e2e-local.sh",
    "e2e:docker": "bash scripts/e2e-docker.sh",
    "e2e:smoke": "bash scripts/e2e-docker.sh --grep @smoke",
    "gate": "bash scripts/gate.sh",
    "desktop:build": "npm run build && npm run server:build && npm run cli:build && node desktop/build.mjs",
    "desktop:dev": "node desktop/build.mjs && electron desktop/dist/main.cjs",
    "desktop:dist": "npm run desktop:build && node desktop/package.mjs",
    "desktop:smoke": "node desktop/smoke.mjs",
    "prepare": "node scripts/hooks.mjs",
    "api:build": "node api/build.mjs",
    "api:serve": "node api/build.mjs && node api/dist/anydag-api.mjs serve",
    "api:db": "docker compose -f api/compose.yaml up -d --wait db",
    "api:dev": "bash api/dev.sh",
    "api:test": "vitest run api/test",
    "api:test:pg": "ANYDAG_API_TEST_PG=${ANYDAG_API_TEST_PG:-postgres://anydag:anydag@127.0.0.1:55432/anydag_api} vitest run api/test/meta.test.ts api/test/routes.test.ts api/test/gc.test.ts",
    "api:up": "node api/build.mjs && docker compose -f api/compose.yaml up -d --build --wait",
    "api:converge": "ANYDAG_API_SEEDS=${ANYDAG_API_SEEDS:-100} vitest run api/test/converge.test.ts",
    "api:demo": "bash scripts/api-demo.sh",
    "sync:build": "npm run api:build",
    "sync:serve": "npm run api:serve",
    "sync:db": "npm run api:db",
    "sync:dev": "npm run api:dev",
    "sync:test:pg": "npm run api:test:pg",
    "sync:up": "npm run api:up",
    "sync:converge": "npm run api:converge",
    "sync:demo": "npm run api:demo"
  },
  "dependencies": {
    "@blocknote/core": "0.57.0",
    "@blocknote/mantine": "0.57.0",
    "@blocknote/react": "0.57.0",
    "@electric-sql/pglite": "^0.5.15",
    "@fontsource/fira-code": "^5.2.6",
    "@fontsource/inter": "^5.2.8",
    "@hono/node-server": "^2.1.6",
    "@iconify/utils": "^3.1.7",
    "@lezer/common": "^1.5.5",
    "@lezer/cpp": "^1.1.6",
    "@lezer/css": "^1.3.9",
    "@lezer/go": "^1.0.1",
    "@lezer/highlight": "^1.2.5",
    "@lezer/html": "^1.3.13",
    "@lezer/java": "^1.1.5",
    "@lezer/javascript": "^1.5.6",
    "@lezer/json": "^1.0.3",
    "@lezer/lr": "^1.4.12",
    "@lezer/python": "^1.1.19",
    "@lezer/rust": "^1.0.3",
    "@lezer/yaml": "^1.0.4",
    "@mantine/core": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@parcel/watcher": "^2.6.0",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-code": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "electron-updater": "^6.8.11",
    "elkjs": "^0.12.1",
    "fflate": "^0.8.3",
    "hono": "^4.13.16",
    "katex": "^0.19.1",
    "lucide-react": "^0.469.0",
    "mdast-util-math": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@blocknote/server-util": "0.57.0",
    "@iconify-json/fluent-emoji-flat": "^1.2.6",
    "@iconify-json/fluent-emoji-high-contrast": "^1.2.6",
    "@iconify-json/logos": "^1.2.19",
    "@iconify-json/simple-icons": "^1.2.101",
    "@playwright/test": "1.65.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "10.14.0",
    "knip": "6.44.2",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-to-markdown": "^2.2.2",
    "micromark-util-types": "^2.0.3",
    "svgo": "^4.1.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
