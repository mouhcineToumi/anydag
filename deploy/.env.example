# The machine's own configuration: `cp deploy/.env.example deploy/.env`, fill in, keep it 0600 —
# it is git-ignored, gitleaks scans the repository, and a secret committed here never leaves it.
# docker compose reads this file when called with -f deploy/compose.yaml; backup.sh and restore.sh
# source it. Generate each of these (`openssl rand -base64 24`); never invent one.

# The site Caddy serves and requests certificates for. `localhost` also works (an internal
# certificate) and is what deploy/restore.sh's test uses.
CADDY_DOMAIN=api.anydag.com

# How many proxies sit in front of the api and append to X-Forwarded-For: 1 for Caddy alone (the
# default), 2 behind a tunnel — which deploy/compose.tunnel.yaml sets itself. Count wrong and the
# rate limits see the proxy instead of the client.
#ANYDAG_API_TRUST_PROXY=1

# How long a token the api will accept in production: 32 characters or better.
ANYDAG_API_ADMIN_TOKEN=

# Postgres' own password, which DATABASE_URL in deploy/compose.yaml embeds.
POSTGRES_PASSWORD=

# The feature switches (on|off). A self-hoster runs sync alone; this machine answers for all
# three. Leaving feedback on without its token and repo is allowed: the relay answers 503 and
# GET /v1 reports the feature absent (#50) — or set the two below and it works.
ANYDAG_API_SYNC=on
ANYDAG_API_LOGS=on
ANYDAG_API_FEEDBACK=on

# The feedback relay (#50): a fine-grained GitHub token that can open issues in the one repo, and
# that repo. Empty is fine for now.
ANYDAG_API_FEEDBACK_GITHUB_TOKEN=
ANYDAG_API_FEEDBACK_REPO=

# -- backups (deploy/backup.sh, deploy/restore.sh) ----------------------------------------------

# An age PUBLIC key: the private key never touches this machine (encrypt here, decrypt where the
# backups land). `age-keygen` prints both.
AGE_PUBLIC_KEY=

# Where backups go, as rclone names it: `remote:bucket/prefix` at a provider OTHER than the one
# this machine runs on. `rclone config` once, on this machine or wherever rclone runs.
BACKUP_REMOTE=

# -- alerts (deploy/README.md, *Alerts*) --------------------------------------------------------

# Dead man's switches at a healthchecks.io-style service, which emails on a /fail ping and on
# silence. One check each; leave empty to run without the alert.
BACKUP_PING_URL=
DISK_PING_URL=
# The disk alert's line, in percent of the filesystem the data volumes are on.
DISK_ALERT_PERCENT=70

# -- behind a tunnel (deploy/compose.tunnel.yaml) -----------------------------------------------

# The tunnel's token, from its provider's dashboard. Only with the tunnel override.
TUNNEL_TOKEN=
