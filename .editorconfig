# Matches biome.jsonc (the formatter) for the files it formats, and the house style elsewhere.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ts,tsx,mts,cts,js,mjs,cjs}]
max_line_length = 130

[*.md]
# A trailing double space is a hard break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
